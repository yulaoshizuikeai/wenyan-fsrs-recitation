<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_card"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Top Header: Title & Badges -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_app_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="文言背诵"
            android:textColor="@color/ink_charcoal"
            android:textSize="14sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Streak Pill -->
        <TextView
            android:id="@+id/widget_streak_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_widget_pill"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="🔥 1天"
            android:textColor="@color/vermilion_accent"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="6dp"
            android:layout_height="wrap_content" />

        <!-- Due Count Pill -->
        <TextView
            android:id="@+id/widget_due_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_widget_pill"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="待复习 0 句"
            android:textColor="@color/bamboo_green"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginVertical="8dp"
        android:background="@color/xuan_border" />

    <!-- Classical Quote of the Day -->
    <TextView
        android:id="@+id/widget_quote_text"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:lineSpacingMultiplier="1.2"
        android:maxLines="3"
        android:text="“山不厌高，海不厌深。周公吐哺，天下归心。”"
        android:textColor="@color/ink_charcoal"
        android:textSize="13sp" />

    <!-- Quote Author & Footer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="4dp">

        <TextView
            android:id="@+id/widget_quote_author"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="—— 曹操《短歌行》"
            android:textColor="@color/ink_faded"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/widget_action_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="点击进入背诵 →"
            android:textColor="@color/bamboo_green"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
